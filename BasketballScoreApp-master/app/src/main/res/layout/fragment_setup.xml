<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".SetupFragment">

    <!-- Team A Name Section -->
    <TextView
        android:id="@+id/teamALabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team A Name"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/teamAInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Team A Name"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/teamALabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Team B Name Section -->
    <TextView
        android:id="@+id/teamBLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team B Name"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/teamAInput"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/teamBInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Team B Name"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/teamBLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Number of Quarters Section -->
    <TextView
        android:id="@+id/quartersLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Number of Quarters"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/teamBInput"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/quartersSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/quartersLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Time Per Quarter Section -->
    <TextView
        android:id="@+id/timePerQuarterLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Time per Quarter (minutes)"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/quartersSpinner"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/timePerQuarterInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter time (e.g., 10)"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/timePerQuarterLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Start Game Button -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Game"
        app:layout_constraintTop_toBottomOf="@id/timePerQuarterInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- View Statistics Button -->
    <Button
        android:id="@+id/viewStatisticsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Statistics"
        app:layout_constraintTop_toBottomOf="@id/startButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
